# Copy to .env for local development.

# --- Service ---
ENVIRONMENT=development
API_PREFIX=/api/v1
# Comma-separated origins allowed to call the API from a browser. Set this to
# the consuming app's origin(s) in production, e.g.
# CORS_ORIGINS=https://app.helpsonroad.com
CORS_ORIGINS=*

# --- Database (async SQLAlchemy URL) ---
# Postgres (default / production):
DATABASE_URL=postgresql+asyncpg://helpsonroad:helpsonroad@localhost:5432/helpsonroad
# SQLite (quick local run, no server needed):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
#
# SERVERLESS (Vercel) + Supabase: Vercel has NO IPv6, and Supabase's DIRECT
# host (db.<ref>.supabase.co:5432) is IPv6-only — connecting to it fails at the
# socket layer (surfaces as uvloop "[Errno 16] Device or resource busy"). Use
# the IPv4 Supavisor TRANSACTION pooler (port 6543); note the user is
# "postgres.<project-ref>" and the host is the regional pooler host:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Auth (JWT) ---
# HS256 shared secret for the legacy/dev-token flow.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
# JWT_ISSUER=helpsonroad
# JWT_AUDIENCE=trip-planner
#
# Asymmetric verification (Supabase / Lovable Cloud sign with ES256). Set the
# JWKS URL and add the asymmetric algs to the decode allow-list; Supabase's
# audience is "authenticated".
# JWT_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# JWT_ALGORITHMS=ES256,RS256,HS256
# JWT_AUDIENCE=authenticated

# --- LLM / PydanticAI ---
AGENT_MODEL=anthropic:claude-sonnet-4-6
ANTHROPIC_API_KEY=
# Force the deterministic offline model (no LLM key needed):
AGENT_USE_TEST_MODEL=false
# Bound conversation history per turn (latency/cost) and cache provider lookups.
AGENT_HISTORY_MAX_MESSAGES=30
PROVIDER_CACHE_TTL_SECONDS=300

# --- External location context ---
ENABLE_EXTERNAL_CONTEXT=true
AUSTRALIA_CONTEXT_BASE_URL=https://www.australia.com
NEPAL_CONTEXT_BASE_URL=https://ntb.gov.np
LOCATION_CONTEXT_TIMEOUT_SECONDS=6

# --- Google Maps Platform (optional) ---
# Set the key to source real places, geocoding, and road routing from Google.
# Leave blank to use the curated catalog + haversine fallback.
GOOGLE_MAPS_API_KEY=
PREFER_GOOGLE=true
GOOGLE_PLACES_RADIUS_M=60000

# --- Sharing ---
SHARE_BASE_URL=https://app.helpsonroad.com/trips/shared
